{
  "name": "farms-lanka-infra",
  "version": "1.0.0",
  "private": true,
  "description": "AWS infrastructure for farmslanka.org (S3 + CloudFront + Route 53)",
  "bin": {
    "farms-lanka": "bin/farms-lanka.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "synth": "cdk synth",
    "diff": "cdk diff",
    "deploy:dns": "cdk deploy FarmsLankaDns",
    "deploy:site": "cdk deploy FarmsLankaSite",
    "deploy:all": "cdk deploy --all"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "aws-cdk": "^2.160.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.6.0"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.160.0",
    "constructs": "^10.3.0",
    "source-map-support": "^0.5.21"
  }
}
