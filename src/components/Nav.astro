---
import { Icon } from 'astro-icon/components';
import Logo from '../assets/brand/logo.svg';

const links = [
	{ href: '#who-we-are', label: 'Who We Are' },
	{ href: '#programs', label: 'Programs' },
	{ href: '#certifications', label: 'Certifications' },
	{ href: '#contact', label: 'Contact' },
];
---

<header class="sticky top-0 z-40 h-[4.5rem] border-b border-brand-800/10 bg-paper-50/95 backdrop-blur">
	<div class="mx-auto flex h-full max-w-(--container-page) items-center justify-between px-6">
		<a href="#top" class="flex items-center gap-3" aria-label="FARMS LANKA — back to top">
			<Logo class="h-10 w-auto shrink-0 text-brand-800" aria-hidden="true" />
			<span class="font-display text-lg font-semibold leading-tight text-brand-900">
				FARMS LANKA
			</span>
		</a>

		<nav class="hidden items-center gap-8 lg:flex">
			{
				links.map((link) => (
					<a
						href={link.href}
						class="text-sm font-medium text-ink-700 transition-colors duration-150 hover:text-brand-700"
					>
						{link.label}
					</a>
				))
			}
			<a
				href="#contact"
				class="rounded-full bg-brand-800 px-5 py-2.5 text-sm font-medium text-paper-50 transition-transform duration-150 ease-out hover:bg-brand-700 active:scale-[0.97]"
			>
				Get in Touch
			</a>
		</nav>

		<button
			id="nav-toggle"
			type="button"
			class="grid h-10 w-10 place-items-center rounded-full text-brand-900 lg:hidden"
			aria-expanded="false"
			aria-controls="mobile-nav"
			aria-label="Toggle navigation menu"
		>
			<Icon name="ph:list" class="h-6 w-6" id="nav-icon-open" />
			<Icon name="ph:x" class="hidden h-6 w-6" id="nav-icon-close" />
		</button>
	</div>

	<nav
		id="mobile-nav"
		class="hidden flex-col gap-1 border-t border-brand-800/10 bg-paper-50 px-6 py-4 lg:hidden"
	>
		{
			links.map((link) => (
				<a
					href={link.href}
					class="rounded-lg px-2 py-3 text-base font-medium text-ink-700 transition-colors duration-150 hover:bg-brand-50 hover:text-brand-700"
				>
					{link.label}
				</a>
			))
		}
		<a
			href="#contact"
			class="mt-2 rounded-full bg-brand-800 px-5 py-3 text-center text-sm font-medium text-paper-50 active:scale-[0.97]"
		>
			Get in Touch
		</a>
	</nav>
</header>

<script>
	const toggle = document.getElementById('nav-toggle');
	const menu = document.getElementById('mobile-nav');
	const iconOpen = document.getElementById('nav-icon-open');
	const iconClose = document.getElementById('nav-icon-close');

	toggle?.addEventListener('click', () => {
		const isOpen = menu?.classList.toggle('flex');
		menu?.classList.toggle('hidden');
		iconOpen?.classList.toggle('hidden');
		iconClose?.classList.toggle('hidden');
		toggle.setAttribute('aria-expanded', String(Boolean(isOpen)));
	});

	menu?.querySelectorAll('a').forEach((link) => {
		link.addEventListener('click', () => {
			menu.classList.add('hidden');
			menu.classList.remove('flex');
			iconOpen?.classList.remove('hidden');
			iconClose?.classList.add('hidden');
			toggle?.setAttribute('aria-expanded', 'false');
		});
	});
</script>
